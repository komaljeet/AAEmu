# project version
PROJECT_VERSION_PREFIX=0.3.0.0
PROJECT_VERSION_SUFFIX=alpha

# build configuration
BUILD_CONFIGURATION=Release
BUILD_FRAMEWORK=net10.0
BUILD_RUNTIME=linux-musl-x64

# db configuration
DB_USER=root
DB_PASSWORD=password

# shared secret between Login and Game servers (inter-server auth).
# Generate a strong value, e.g.: openssl rand -base64 32
SECRET_KEY=change-me

# Public address clients use to reach the game server (VPS public IP or domain).
# Login hands this to clients, so it must be externally reachable — NOT 127.0.0.1.
PUBLIC_HOST=127.0.0.1
